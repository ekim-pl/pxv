{
  "schemaVersion": 1,
  "id": "reference-five",
  "version": "0.1.0",
  "name": "Five-profile structural starter",
  "capabilities": ["normal_credentials", "duress", "network", "backup"],
  "requiredAttestations": [
    "routes",
    "network_failure_tests",
    "backup_recovery",
    "recipient_acceptance",
    "operator_signoff"
  ],
  "repositories": [],
  "profiles": [
    {
      "id": "owner",
      "name": "owner",
      "kind": "owner",
      "packages": [],
      "settings": [],
      "permissions": [],
      "vpn": { "packageId": null, "alwaysOn": false, "lockdown": false },
      "defaultCredential": { "type": "password", "secretRef": "owner-password" },
      "defaultDuress": {
        "ownerCredentialRef": "owner-current",
        "pinRef": "duress-pin",
        "passwordRef": "duress-password"
