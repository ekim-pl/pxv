{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "paths": { "@pxv/*": ["./packages/*/src/index.ts"] }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "tools/**/*.mjs", "eslint.config.mjs"]
}
