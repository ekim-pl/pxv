# pxv does not implicitly load .env files. Export only the settings required.
# PXV_ROOT=/absolute/path/to/new-typescript-project
# PXV_CONTROL_ROOT=/home/operator/.local/state/pxv-host-control
# PXV_EXTENSION_ROOT=/home/operator/.local/share/pxv/extensions
# Selection and recovery rules: docs/operators/host-setup.md#environment-selection
# Empty SDK/JDK homes fall through; nonempty homes are verbatim, with no lower-home fallback.
# PXV_ANDROID_HOME=/home/operator/Android/Sdk
# ANDROID_HOME=/home/operator/Android/Sdk
# PXV_JAVA_HOME=/absolute/path/to/jdk
# JAVA_HOME=/absolute/path/to/jdk
# PXV_TOOL_ADB=/absolute/path/to/adb
# PXV_HOST_ADB_HOST=127.0.0.1
# PXV_HOST_ADB_PORT=5037
# PXV_ADB_SERVER_SOCKET=tcp:127.0.0.1:5037
# PXV_ADB_VENDOR_KEYS=/absolute/path/to/private/adb-keys
# Native ADB_SERVER_SOCKET/ADB_VENDOR_KEYS are not pxv selection inputs.
# Registry credentials belong in the operator environment only during explicit install.
# Final credentials and recovery material are entered privately by the recipient.
