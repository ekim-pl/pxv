<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Synthetic test data only. No credentials or personal data." />
    <EditText android:id="@+id/configuration" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:inputType="text"
        android:hint="Synthetic backup marker" />
    <Switch android:id="@+id/enabled" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Fixture enabled" />
    <Button android:id="@+id/save" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Save synthetic configuration" />
    <Button android:id="@+id/import_file" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Import synthetic document" />
    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Ready" />
</LinearLayout>
