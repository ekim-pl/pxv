{
  "name": "pxv-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "build": "tsc -b",
    "build:native": "node tools/build-native.mjs",
    "check": "pnpm build && eslint packages tests tools && node tools/check-boundaries.mjs && prettier --check 'packages/**/*.ts' 'tests/**/*.ts' 'tools/*.mjs' && pnpm docs:check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:native": "node tools/build-native.mjs --test",
    "build:preview": "pnpm build && node packages/release/dist/cli.js",
    "pxv": "node packages/cli/dist/main.js",
    "docs:build": "pnpm build && node packages/release/dist/docs.js",
    "docs:check": "node tools/check-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
